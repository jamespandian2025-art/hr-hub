NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_ENABLE_SUPABASE_AUTH=false
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_LEGAL_NAME=WiseFlow
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_BILLING_MODE=manual
AUTH_SESSION_SECRET=replace-with-a-long-random-production-secret

# Never expose the service-role key with a NEXT_PUBLIC_ prefix.

# Optional local-only file store paths. Do not use these for production deploys unless
# the runtime provides durable private storage.
BUSINESS_DATA_DIR=
HRHUB_DATA_DIR=
RATE_LIMIT_DATA_DIR=
WISEFLOW_UPLOAD_BUCKET=wiseflow-uploads
MONITORING_BASE_URL=https://your-production-domain.com

# Employee credential email provider. Configure one provider in Vercel for Send login to send real email.
EMAIL_FROM=hr@your-domain.com
EMAIL_TEST_RECIPIENT=
EMAIL_TEST_SEND=0

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hr@your-domain.com

# Or Brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=hr@your-domain.com

# Or SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hr@your-domain.com

# Optional WiseFlow AI Assistant. Keep the API key server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
